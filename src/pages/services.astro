---
import Navigation from "../components/Navigation.astro";
import Footer from "../components/Footer.astro";
import { siteConfig } from "../config/content.ts";

const services = [
  {
    number: "01",
    title: "Software Development",
    description:
      "Development of customized software solutions for businesses, professionals and personal projects.",
    items: [
      "Web applications",
      "Desktop applications",
      "Mobile applications",
    ],
  },
  {
    number: "02",
    title: "Interactive Experiences",
    description:
      "Creation of educational and immersive applications using interactive technologies.",
    items: [
      "Educational games",
      "Virtual reality applications",
      "Augmented reality applications",
    ],
  },
  {
    number: "03",
    title: "Computer Support",
    description:
      "Installation, maintenance and technical assistance for desktop and portable computers.",
    items: [
      "Computer assembly",
      "Desktop and laptop maintenance",
      "Software installation and configuration",
      "Remote technical support",
    ],
  },
  {
    number: "04",
    title: "Smart Home & Security",
    description:
      "Installation and configuration of connected devices for safer and more efficient spaces.",
    items: [
      "Security cameras",
      "Alexa devices",
      "Home automation",
      "Smart locks",
      "Smart lights and switches",
    ],
  },
];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>Services - Your Portfolio</title>
    <meta name="description" content="Read my latest services" />
    <script is:inline>
      (function () {
        const savedTheme = localStorage.getItem("theme") || "dark";
        const prefersDark = window.matchMedia(
          "(prefers-color-scheme: dark)"
        ).matches;
        const initialTheme =
          savedTheme === "system"
            ? prefersDark
              ? "dark"
              : "light"
            : savedTheme;

        if (initialTheme === "dark") {
          document.documentElement.classList.add("dark");
        } else {
          document.documentElement.classList.remove("dark");
        }
      })();
    </script>
    <script>
      document.addEventListener("DOMContentLoaded", function () {
        window
          .matchMedia("(prefers-color-scheme: dark)")
          .addEventListener("change", (e) => {
            if (localStorage.getItem("theme") === "system") {
              if (e.matches) {
                document.documentElement.classList.add("dark");
              } else {
                document.documentElement.classList.remove("dark");
              }
            }
          });
      });
    </script>
    
    <style>
      html,
      body {
        margin: 0;
        padding: 0;
        height: 100%;
        overflow-x: hidden;
      }
      body {
        display: flex;
        flex-direction: column;
        min-height: 100vh;
      }
      main {
        flex: 1;
      }
      section[class*="text-gray-700"] {
        margin: 0;
        padding: 0;
        flex-shrink: 0;
      }

      .dot-hexagon-light {
        background-image: radial-gradient(
            circle,
            #80808045 1px,
            transparent 1px
          ),
          radial-gradient(circle, #80808045 1px, transparent 1px);
        background-size: 24px 41.57px;
        background-position:
          0 0,
          12px 20.78px;
      }

      .dot-hexagon-dark {
        background-image: radial-gradient(
            circle,
            #ffffff35 1px,
            transparent 1px
          ),
          radial-gradient(circle, #ffffff35 1px, transparent 1px);
        background-size: 24px 41.57px;
        background-position:
          0 0,
          12px 20.78px;
      }
    </style>
  </head>
  <body class="bg-white dark:bg-neutral-900 transition-colors duration-300">
    <div class="fixed inset-0 z-0 pointer-events-none">
      <div
        class="absolute inset-0 -z-10 dot-hexagon-light dark:dot-hexagon-dark"
      >
      </div>
      <div
        class="absolute inset-0 bg-[radial-gradient(ellipse_80%_80%_at_50%_50%,transparent_0%,rgba(255,255,255,0.5)_60%,rgba(255,255,255,0.9)_85%,white_100%)] dark:bg-[radial-gradient(ellipse_80%_80%_at_50%_50%,transparent_0%,rgba(23,23,23,0.5)_60%,rgba(23,23,23,0.9)_85%,rgb(23,23,23)_100%)] -z-10"
      >
      </div>
      <div
        class="absolute left-0 right-0 top-0 -z-10 m-auto h-[1200px] w-[1200px] rounded-full bg-neutral-400 opacity-10 blur-[100px]"
      >
      </div>
    </div>

    <main class="flex-1 relative z-10">
      <Navigation />
      <section
  class="relative z-20 w-full max-w-5xl mx-auto px-4 sm:px-6 mt-24 mb-16"
>
  <div class="mb-10">
    <p
      class="mb-2 text-sm font-semibold uppercase tracking-widest text-neutral-500 dark:text-neutral-400"
    >
      What I can do
    </p>

    <h1
      class="text-3xl font-bold tracking-tight text-neutral-900 dark:text-neutral-100 sm:text-4xl"
    >
      Services
    </h1>

    <p class="mt-4 max-w-2xl text-neutral-600 dark:text-neutral-400">
      Technology solutions organized according to your development, technical
      support and smart home needs.
    </p>
  </div>

  <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
    {
      services.map((service) => (
        <article
          class="rounded-2xl border border-dashed border-neutral-300 bg-white/80 p-6 dark:border-neutral-700 dark:bg-neutral-950/80"
        >
          <span
            class="inline-flex h-10 w-10 items-center justify-center rounded-xl bg-neutral-900 text-sm font-bold text-white dark:bg-neutral-100 dark:text-neutral-900"
          >
            {service.number}
          </span>

          <h2
            class="mt-5 text-xl font-bold text-neutral-900 dark:text-neutral-100"
          >
            {service.title}
          </h2>

          <p class="mt-3 leading-7 text-neutral-600 dark:text-neutral-400">
            {service.description}
          </p>

          <ul class="mt-5 space-y-3">
            {service.items.map((item) => (
              <li
                class="flex items-start gap-3 text-neutral-700 dark:text-neutral-300"
              >
                <svg
                  class="mt-1 h-4 w-4 flex-none text-green-500"
                  viewBox="0 0 20 20"
                  fill="currentColor"
                  aria-hidden="true"
                >
                  <path
                    fill-rule="evenodd"
                    clip-rule="evenodd"
                    d="M16.704 5.292a1 1 0 010 1.416l-8 8a1 1 0 01-1.416 0l-4-4a1 1 0 011.416-1.416L8 12.586l7.296-7.294a1 1 0 011.408 0z"
                  />
                </svg>

                <span>{item}</span>
              </li>
            ))}
          </ul>
        </article>
      ))
    }
  </div>
</section>
    </main>

    <Footer />
  </body>
</html>
